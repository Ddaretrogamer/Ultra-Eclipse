mapscripts Route1N_MapScripts{
}

script TrainerSchoolSign{
    lock
    msgbox("Let's learn and grow.\n"
        "Let's grow and train.\l"
        "Unsullied, enjoyable, and academic.\l"
        "Everyone starts at the beginning!")
    release
end    
}

script TrainersSchool_Intro{
    lock
    getplayerxy(VAR_TEMP_3, VAR_TEMP_4)
    if (var(VAR_TEMP_3) == 20 && var(VAR_TEMP_4) == 23){
        applymovement(LOCALID_PLAYER, moves(walk_up, walk_left, face_up))
        waitmovement(LOCALID_PLAYER)
    }
    elif (var(VAR_TEMP_3) == 18 && var(VAR_TEMP_4) == 23){
        applymovement(LOCALID_PLAYER, moves(walk_up, walk_right, face_up))
        waitmovement(LOCALID_PLAYER)
    }
    else{
        applymovement(LOCALID_PLAYER, moves(walk_up))
        waitmovement(LOCALID_PLAYER)
    }
    setvar(VAR_IKITOWN_STATE, 22)
    startcutscene(CUTSCENE_TRAINER_SCHOOL_INTRO)
    applymovement(trainerschool_lillie, moves(face_left))
    waitmovement(trainerschool_lillie)
    applymovement(trainerschool_kukui, moves(walk_in_place_down*2))
    waitmovement(trainerschool_kukui)
    speakername("Kukui")
    msgbox("Hey there, {PLAYER}!
    I must've passed you somehow, yeah?
    
    But welcome to the Trainers' School,
    the place to learn how to be a
    Pokémon Trainer!", MSGBOX_AUTOCLOSE)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    playse(SE_PIN)
    applymovement(trainerschool_teacher, moves(emote_exclamation_mark))
    waitmovement(trainerschool_teacher)
    msgbox("Professor Kukui!
    Is this the child you told me about?", MSGBOX_AUTOCLOSE)
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    speakername("Kukui")
    msgbox("Yeah. {PLAYER}'s a tough one,too.
    Put em through the wringer good, Teach!")
    applymovement(trainerschool_kukui, moves(jump_in_place_down*2))
    playse(SE_LEDGE)
    waitse
    playse(SE_LEDGE)
    waitse
    waitmovement(0)
    msgbox("Four Trainers!
    
    You've got to beat four Pokémon
    Trainers at the school, {PLAYER}!
    
    The experience will surely help you
    and your Pokemon grow stronger,
    yeah.
    
    Actually\. Speaking of experience,
    why don't you take this.")
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    giveitem(ITEM_EXP_SHARE, 1)
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    speakername("Kukui")
    msgbox("If you keep that Exp. Share on, yeah,
    all the Pokémon on your team can get
    Exp. Points from battle.", MSGBOX_AUTOCLOSE)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    applymovement(trainerschool_teacher, moves(walk_in_place_down*2))
    waitmovement(trainerschool_teacher)
    msgbox("The Trainers who will take part in this
    lesson may be inside or outside the
    school.
    
    You may also want to visit our
    classrooms.
    
    You'll learn things there that will
    help on your journey, I'd say.")
    applymovement(trainerschool_teacher, moves(jump_in_place_down*2))
    playse(SE_LEDGE)
    waitse
    playse(SE_LEDGE)
    waitse
    msgbox("All right. Let the lesson begin!", MSGBOX_AUTOCLOSE)
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    applymovement(trainerschool_teacher, moves(walk_up*4))
    waitmovement(trainerschool_teacher)
    removeobject(trainerschool_teacher)
    setflag(FLAG_HIDE_TRAINERSCHOOL_TEACHER)
    applymovement(trainerschool_kukui, moves(walk_in_place_down*2))
    waitmovement(trainerschool_kukui)
    speakername("Kukui")
    msgbox("She may not look all that tough, but
    that each trains her kids right!
    One of her students is even a captain!")
    applymovement(trainerschool_lillie, moves(face_down))
    waitmovement(trainerschool_lillie)
    msgbox("If you want a bit of advice from me,
    here's something that might help.
    
    Once you've fought a species of
    Pok\emon once, You can easily see
    what types of moves will work best
    on it in your next battle.
    
    Wandering about in the tall grass to
    meet lots of different Pokémon'll
    help with that!", MSGBOX_AUTOCLOSE)
    endcutscene
    applymovement(trainerschool_kukui, moves(jump_in_place_down*2))
    playse(SE_LEDGE)
    waitse
    playse(SE_LEDGE)
    waitse
    msgbox("Battle all the time, oh yeah!", MSGBOX_AUTOCLOSE)
    release
    end
}

script TrainersSchool_Intro_Skip{
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    applymovement(trainerschool_lillie, moves(face_down))
    waitmovement(trainerschool_lillie)
    removeobject(trainerschool_teacher)
    setflag(FLAG_HIDE_TRAINERSCHOOL_TEACHER)
    special(StopAllObjectMovements)
    special(CloseScriptMenus)
    hideitemdescription
    checkitem(ITEM_EXP_SHARE, 1)
    if (var(VAR_RESULT) == FALSE){
        additem(ITEM_EXP_SHARE, 1)
    }
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
}

script TrainersSchool_BattleVs_Hiromi{
    lock
    goto_if_not_defeated(TRAINER_LASS_HIROMI, TrainersSchool_BattleVs_Hiromi2)
    msgbox("You can help your Pokémon win by using
    items at the right time.
    
    They can do more than just healing
    your Pokémon's HP too.
    
    You can even boost their stats and
    things like that.", MSGBOX_AUTOCLOSE)
    release
    end
}

script TrainersSchool_BattleVs_Hiromi2{
    playse(SE_PIN)
    applymovement(trainerschool_lass1, moves(emote_exclamation_mark))
    waitmovement(trainerschool_lass1)
    waitse
    trainerbattle_single(TRAINER_LASS_HIROMI, "If my previous Bonsly takes damage,\nI'll want to use a Potion on it!", "Don't worry-I'll heal any pain that was\ncaused by our defeat!", music=FALSE)
    msgbox("You can help your Pokémon win by using
    items at the right time.
    
    They can do more than just healing
    your Pokémon's HP too.
    
    You can even boost their stats and
    things like that.", MSGBOX_AUTOCLOSE)
    release
    end
}

script TrainersSchool_RockPaperScissors{
    lock
    speakername("Little Boy")
    msgbox("Ready, and\.")
    speakername("Little Girl")
    msgbox("GRASS, FIRE, WATER!")
    playse(SE_PIN)
    applymovement(trainerschool_littleboy, moves(emote_exclamation_mark))
    applymovement(trainerschool_littlegirl, moves(emote_exclamation_mark))
    waitmovement(0)
    waitse
    speakername("Little Boy")
    msgbox("Um\.
    Which one wins again?")
    applymovement(trainerschool_littleboy, moves(face_down))
    applymovement(trainerschool_littlegirl, moves(face_down))
    waitmovement(0)
    random(2)
    if (var(VAR_RESULT) == 0){
        speakername("Little Girl")
        msgbox("Which would win in a matchup between
        Grass type and Water type?", MSGBOX_AUTOCLOSE)
        dynmultichoice(22,6,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Fire", "Water", "Grass")
        if (var(VAR_RESULT) == 0){
            speakername("Little Boy")
            msgbox("You sure? I'm pretty sure it's not\.
            Are you messing with us maybe?")
        }
        elif (var(VAR_RESULT) == 1){
            speakername("Little Boy")
            msgbox("You sure? I'm pretty sure it's not\.
            Are you messing with us maybe?")
        }
        elif (var(VAR_RESULT) == 2){
            applymovement(trainerschool_littlegirl, moves(jump_in_place_down*2))
            playse(SE_LEDGE)
            waitse
            playse(SE_LEDGE)
            waitse
            speakername("Little Girl")
            msgbox("Right, right! Yeah, that's it.
            You must be a great Trainer!")
        }
    }
    elif (var(VAR_RESULT) == 1){
        speakername("Little Girl")
        msgbox("Which would win in a matchup between
        Fire type and Grass type?", MSGBOX_AUTOCLOSE)
        dynmultichoice(22,6,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Fire", "Water", "Grass")
        if (var(VAR_RESULT) == 0){
            applymovement(trainerschool_littlegirl, moves(jump_in_place_down*2))
            playse(SE_LEDGE)
            waitse
            playse(SE_LEDGE)
            waitse
            speakername("Little Girl")
            msgbox("Right, right! Yeah, that's it.
            You must be a great Trainer!")
        }
        elif (var(VAR_RESULT) == 1){
            speakername("Little Boy")
            msgbox("You sure? I'm pretty sure it's not\.
            Are you messing with us maybe?")
        }
        elif (var(VAR_RESULT) == 2){
            speakername("Little Boy")
            msgbox("You sure? I'm pretty sure it's not\.
            Are you messing with us maybe?")
        }
    }
    elif (var(VAR_RESULT) == 2){
        speakername("Little Boy")
        msgbox("Which would win in a matchup between
        Water type and Fire type?", MSGBOX_AUTOCLOSE)
        dynmultichoice(22,6,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Fire", "Water", "Grass")
        if (var(VAR_RESULT) == 0){
            speakername("Little Girl")
            msgbox("You sure? I'm pretty sure it's not\.
            Are you messing with us maybe?")
        }
        elif (var(VAR_RESULT) == 1){
            applymovement(trainerschool_littlegirl, moves(jump_in_place_down*2))
            playse(SE_LEDGE)
            waitse
            playse(SE_LEDGE)
            waitse
            speakername("Little Girl")
            msgbox("Right, right! Yeah, that's it.
            You must be a great Trainer!")
        }
        elif (var(VAR_RESULT) == 2){
            speakername("Little Girl")
            msgbox("You sure? I'm pretty sure it's not\.
            Are you messing with us maybe?")
        }
    }
    applymovement(trainerschool_littleboy, moves(face_left))
    applymovement(trainerschool_littlegirl, moves(face_right))
    waitmovement(0)
    release
    end
}

script TrainersSchool_BattleVs_Joey{
    lock
    goto_if_not_defeated(TRAINER_YOUNGSTER_JOEY, TrainersSchool_BattleVS_joey2)
    faceplayer
    msgbox("Grass-type Pokémon are immune to
    powder moves, like Poison Powder and
    Sleep Powder.
    
    But you can still poison 'em with Poison
    Gas!", MSGBOX_AUTOCLOSE)
    release
    end
}

script TrainersSchool_BattleVS_joey2{
    playse(SE_PIN)
    applymovement(trainerschool_joey, moves(emote_exclamation_mark, face_player))
    waitmovement(trainerschool_joey)
    waitse
    trainerbattle_single(TRAINER_YOUNGSTER_JOEY, "I'll show you my Grimer's best move!\nWith Poison Gas, it'll poison\leveryone that comes at us!",
    "No! The Grimer I found in the tall grass\nnear the school was defeated?", event_script=FALSE, music=FALSE)
    msgbox("Grass-type Pokémon are immune to
    powder moves, like Poison Powder and
    Sleep Powder.
    
    But you can still poison 'em with Poison
    Gas!", MSGBOX_AUTOCLOSE)
    release
    end
}

script TrainersSchool_Lillie{
    lock
    applymovement(trainerschool_lillie, moves(face_player))
    specialvar(VAR_RESULT, IsPlayerPartyFullyHealed)
        if(var(VAR_RESULT) == TRUE){
            speakername("Lillie")
            msgbox("You can tell me anytime that you want
            your team's health restored.
            
            Seeing a Pok\emon in pain makes my own
            heart seem to ache\.")
            release
            end
        }
        else
        {
            speakername("Lillie")
            bufferleadmonspeciesname(STR_VAR_1)
            msgbox("Let me take care of poor
            {STR_VAR_1}, OK?")
            fadescreenswapbuffers(FADE_TO_BLACK)
            playfanfare(MUS_HEAL)
            special(HealPlayerParty)
            waitfanfare
            fadescreenswapbuffers(FADE_FROM_BLACK)
            speakername("Lillie")
            msgbox("Please try not to push your Pokémon
            too hard\.
            Um\.I mean\.if you don't mind\.")
        }
    release
    end
}

script TrainersSchool_Kukui{
    lock
    applymovement(trainerschool_kukui, moves(face_player))
    speakername("Kukui")
    msgbox("If you want a bit of advice from me,
    here's something that might help.
    
    Once you've fought a species of
    Pok\emon once, You can easily see
    what types of moves will work best
    on it in your next battle.
    
    Wandering about in the tall grass to
    meet lots of different Pokémon'll
    help with that!
    
    Battle all the time, oh yeah!", MSGBOX_AUTOCLOSE)
    release
    end
}


script TrainersSchool_BattleVs_Joseph{
    lock
    faceplayer
    goto_if_not_defeated(TRAINER_YOUNGSTER_JOEY, TrainersSchool_BattleVs_Joseph2)
    goto_if_not_defeated(TRAINER_LASS_HIROMI, TrainersSchool_BattleVs_Joseph2)
    goto_if_not_defeated(TRAINER_SCHOOLKID_MIA, TrainersSchool_BattleVs_Joseph2)
    goto_if_defeated(TRAINER_SCHOOLKID_JOSEPH, TrainersSchool_BattleVs_Joseph3)
    playse(SE_PIN)
    applymovement(trainerschool_joseph, moves(emote_exclamation_mark, face_player))
    waitmovement(trainerschool_joseph)
    waitse
    fadescreenswapbuffers(FADE_TO_BLACK)
    hidefollower
    getplayerxy(VAR_TEMP_A, VAR_TEMP_B)
    if (var(VAR_TEMP_A) == 13 && var(VAR_TEMP_B) == 19){
        applymovement(LOCALID_PLAYER, moves(walk_faster_left*3, face_right))
        waitmovement(LOCALID_PLAYER)
    }
    elif (var(VAR_TEMP_A) == 14 && var(VAR_TEMP_B) == 20){
        applymovement(LOCALID_PLAYER, moves(walk_faster_left*4, walk_faster_up,face_right))
        waitmovement(LOCALID_PLAYER)
    }
    elif (var(VAR_TEMP_A) == 14 && var(VAR_TEMP_B) == 18){
        applymovement(LOCALID_PLAYER, moves(walk_faster_left*4, walk_faster_down,face_right))
        waitmovement(LOCALID_PLAYER)
    }
    elif (var(VAR_TEMP_A) == 15 && var(VAR_TEMP_B) == 19){
        applymovement(LOCALID_PLAYER, moves(walk_faster_left*5, face_right))
        waitmovement(LOCALID_PLAYER)
    }
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    trainerbattle_single(TRAINER_SCHOOLKID_JOSEPH,"Looks like you beat everyone else, huh?\pDon't think you'll beat me the same way!\nEkan's Ability is gonna get you!","Even after your Attack is lowered\.\nAn indominable spirit indeed!", TrainersSchool_BattleVs_Joseph4, music = FALSE)
    release
    end
}

script TrainersSchool_BattleVs_Joseph2{
    msgbox("You wanna know why I'm standing here?
    'Cause I'm the strongest, that's why!
    
    I won't even bother battling you
    unless you can beat everyone else here!", MSGBOX_AUTOCLOSE)
    release
    end
}

script TrainersSchool_BattleVs_Joseph3{
    msgbox("OK. First thing to know about TMs.
    
    Technical Machines teach new moves.
    But if your Pok\emon cant learn the
    move in a TM, then too bad.
    
    Second thing to know about TMs.
    
    You can use a TM as many times as you
    want, on as many different Pok\emon as
    you want.
    
    They don't wear out or get used up.
    Pretty nice gift from me, huh?")
    release
    end
}

script TrainersSchool_BattleVs_Joseph4{
    setflag(FLAG_HIDE_TRAINERSCHOOL_BLOCKINGMEOWTH)
    startcutscene(CUTSCENE_TRAINER_SCHOOL_JOSEPH_BATTLE)
    msgbox("Intimidate is an Ability that lowers
    your opponent's Attack Stat.
    
    If you understand your Pok\emon's
    Abilities, you can use the best
    strategies in battle.
    
    But fine! Whatever!
    
    I can admit it when I'm beat.
    I'll give you a reward even.
    Take this Technical Machine!", MSGBOX_AUTOCLOSE)
    giveitem(ITEM_TM01)
    msgbox("OK. First thing to know about TMs.
    
    Technical Machines teach new moves.
    But if your Pok\emon cant learn the
    move in a TM, then too bad.
    
    Second thing to know about TMs.
    
    You can use a TM as many times as you
    want, on as many different Pok\emon as
    you want.
    
    They don't wear out or get used up.
    Pretty nice gift from me, huh?", MSGBOX_AUTOCLOSE)
    applymovement(trainerschool_lillie, moves(walk_faster_up*5, walk_left*8))
    waitmovement(0)
    applymovement(trainerschool_lillie, moves(face_up, emote_exclamation_mark))
    applymovement(LOCALID_PLAYER, moves(face_up, emote_exclamation_mark))
    waitmovement(0)
    playse(SE_PIN)
    playse(SE_DING_DONG)
    waitse
    applymovement(trainerschool_lillie, moves(walk_in_place_down*2))
    waitmovement(trainerschool_lillie)
    speakername("Lillie")
    msgbox("Oh, that's the school bell.", MSGBOX_AUTOCLOSE)
    delay(30)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    playse(SE_DING_DONG)
    applymovement(trainerschool_lillie, moves(face_up, emote_exclamation_mark))
    applymovement(LOCALID_PLAYER, moves(face_up, emote_exclamation_mark))
    waitmovement(0)
    waitse
    msgbox("Attention all students\.
    
    Would {PLAYER} please come to the
    office on 2F?
    
    {PLAYER} to the 2F office, please.")
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)   
    applymovement(trainerschool_lillie, moves(walk_in_place_down*2))
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement(0)
    speakername("Lillie")
    msgbox("What terrible thing did you do to get
    called to the office so soon?")
    dynmultichoice(20 ,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Nothing!", "Well\.")
    if (var(VAR_RESULT) == 0){
        playse(SE_PIN)
        applymovement(trainerschool_lillie, moves(emote_exclamation_mark))
        waitmovement(trainerschool_lillie)
        waitse
        speakername("Lillie")
        msgbox("That's what you say\.")
    }
    else
    {
        playse(SE_PIN)
        applymovement(trainerschool_lillie, moves(emote_exclamation_mark))
        waitmovement(trainerschool_lillie)
        waitse
        speakername("Lillie")
        msgbox("So you did do something?!")
    }
    endcutscene
    release
    end
}

script TrainersSchool_BlockingTauros{
    lock
    if(var(VAR_IKITOWN_STATE) == 24)
    {
        hidefollower
        applymovement(trainerschool_tauros, moves(unlock_anim, face_right))
        applymovement(trainerschool_hala, moves(face_down))
        waitmovement(0)
        speakername("Hala")
        msgbox("Where will you try petting Tauros?")
        dynmultichoice(20 ,6,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Pet its face", "Stroke its mane", "Grab its tail")
        if (var(VAR_RESULT) == 0){
            setflag(FLAG_SUPPRESS_SPEAKER_NAME)
            playmoncry(SPECIES_TAUROS, 0)
            applymovement(trainerschool_tauros, moves(emote_heart))
            msgbox("Bwoh!", MSGBOX_AUTOCLOSE)
            waitmovement(trainerschool_tauros)
            delay(30)
            clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
            applymovement(trainerschool_hala, moves(face_right))
            waitmovement(trainerschool_hala)
            speakername("Hala")
            msgbox("Ha ha ha! You see that? This rascal
            already loves you!
            
            Pok\emon become happier when we show
            them some {COLOR RED}care{COLOR DARK_GRAY}.", MSGBOX_AUTOCLOSE)
        }
        elif (var(VAR_RESULT) == 1){
            setflag(FLAG_SUPPRESS_SPEAKER_NAME)
            playmoncry(SPECIES_TAUROS, 0)
            applymovement(trainerschool_tauros, moves(emote_heart))
            msgbox("Bwoh!", MSGBOX_AUTOCLOSE)
            waitmovement(trainerschool_tauros)
            delay(30)
            clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
            applymovement(trainerschool_hala, moves(face_right))
            waitmovement(trainerschool_hala)
            speakername("Hala")
            msgbox("Ha ha ha! You see that? This rascal
            already loves you!
            
            Pok\emon become happier when we show
            them some {COLOR RED}care{COLOR DARK_GRAY}.", MSGBOX_AUTOCLOSE)
        }
        elif (var(VAR_RESULT) == 2){
            setflag(FLAG_SUPPRESS_SPEAKER_NAME)
            playse(SE_PIN)
            applymovement(trainerschool_tauros, moves(face_left, emote_exclamation_mark))
            waitmovement(trainerschool_tauros)
            waitse
            delay(30)
            clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
            applymovement(trainerschool_hala, moves(face_right))
            waitmovement(trainerschool_hala)
            speakername("Hala")
            msgbox("Hrmmm. That doesn't seem to have
            impressed Tauros very much.", MSGBOX_AUTOCLOSE)
        }
        applymovement(LOCALID_PLAYER, moves(walk_down, face_up, delay_16*2, face_right))
        applymovement(trainerschool_tauros, moves(walk_right*3))
        applymovement(trainerschool_hala, moves(walk_right*3))
        waitmovement(0)
        delay(30)
        applymovement(trainerschool_hala, moves(face_left))
        waitmovement(trainerschool_hala)
        speakername("Hala")
        msgbox("Wa ha ha! Oh the places you'll go, child!
        
        And as you do, you will surely meet more
        Pok\emon and people who will enrich
        your life.", MSGBOX_AUTOCLOSE)
        delay(30)
        applymovement(trainerschool_hala, moves(walk_right*7))
        applymovement(trainerschool_tauros, moves(walk_right*7))
        waitmovement(0)
        applymovement(trainerschool_hau, moves(walk_up, walk_right, face_down))
        applymovement(LOCALID_PLAYER, moves(delay_16*4, face_up))
        waitmovement(0)
        speakername("Hau")
        msgbox("The kahunas sure are something, eh?
        Able to calm a raging Pok\emon
        without even needing to battle\.
        
        I mean, I like Tauros plenty and all\.
        {PAUSE 15}but it is pretty scary!
        
        I don't want to ride on it!", MSGBOX_AUTOCLOSE)
        applymovement(trainerschool_hau, moves(jump_in_place_down*2))
        playse(SE_LEDGE)
        waitse
        playse(SE_LEDGE)
        waitse
        waitmovement(trainerschool_hau)
        speakername("Hau")
        msgbox("Why don't you head off to Hau'oli City
        and explore a bit?
        
        You just got here to Alola, huh?
        
        I'll tag along!
        I wanna get something good to eat!
        
        What're we waiting for?
        This way. Come on!", MSGBOX_AUTOCLOSE)
        applymovement(trainerschool_hau, moves(walk_fast_left*8))
        waitmovement(trainerschool_hau)
        setflag(FLAG_HIDE_TRAINERSCHOOL_HALA)
        setflag(FLAG_HIDE_TRAINERSCHOOL_TAUROS)
        removeobject(trainerschool_hala)
        removeobject(trainerschool_tauros)
        removeobject(trainerschool_hau)
        setvar(VAR_IKITOWN_STATE, 25)
        release
        end
    }
    else
    {
        applymovement(trainerschool_tauros, moves(face_player))
        waitmovement
        playmoncry(SPECIES_TAUROS, 0)
        msgbox("Graah!", MSGBOX_AUTOCLOSE)
        waitmoncry
        playse(SE_PIN)
        applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark, lock_facing_direction, jump_right))
        waitmovement(LOCALID_PLAYER)
        release
        end
    }
}

script TrainersSchool_Joseph_Battle_Skip{
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    setobjectxy(trainerschool_lillie, 12, 16)
    applymovement(trainerschool_lillie, moves(face_down))
    waitmovement(trainerschool_lillie)
    special(StopAllObjectMovements)
    special(CloseScriptMenus)
    hideitemdescription
    checkitem(ITEM_TM01, 1)
    if (var(VAR_RESULT) == FALSE){
        additem(ITEM_TM01, 1)
    }
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
}

script TrainersSchool_Trigger_BlockingHala{
    lockall
    setvar(VAR_IKITOWN_STATE, 24)
    playmoncry(SPECIES_TAUROS, 0)
    applymovement(trainerschool_tauros, moves(walk_in_place_right*2, lock_anim))
    msgbox("Moo-aaarrr!", MSGBOX_AUTOCLOSE)
    waitmovement(trainerschool_tauros)
    waitmoncry
    delay(30)
    getplayerxy(VAR_TEMP_A,VAR_TEMP_B)
    if (var(VAR_TEMP_B) == 25){ 
        applymovement(LOCALID_PLAYER, moves(walk_left))
        waitmovement(LOCALID_PLAYER)
    }
    elif(var(VAR_TEMP_B) == 26){
        applymovement(LOCALID_PLAYER, moves(walk_up, walk_left))
        waitmovement(LOCALID_PLAYER)
    }
    else{
        applymovement(LOCALID_PLAYER, moves(walk_down, walk_left))
        waitmovement(LOCALID_PLAYER)
    }
    playse(SE_PIN)
    applymovement(trainerschool_hala, moves(emote_exclamation_mark, face_right))
    applymovement(trainerschool_hau, moves(delay_16, face_right))
    waitmovement(0)
    waitse
    speakername("Hala")
    msgbox("Ho! If it isn't {PLAYER}.
    
    Sorry for scaring you, friend.
    It's time I get old Tauros back home.
    
    Oh, but I've got an idea\.
    Why not give him a little pat?", MSGBOX_AUTOCLOSE)
    releaseall
    end
}

script TrainersSchool_BlockingHala{
    lock
    hidefollower
    faceplayer
    speakername("Hala")
    msgbox("Why don't you give Tauros a little pat?", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_down, face_left))
    applymovement(trainerschool_hala, moves(delay_16*3, face_down))
    waitmovement(0)
    call(TrainersSchool_BlockingTauros)
}

script TrainersSchool_BlockingHau{
    lock
    hidefollower
    faceplayer
    speakername("Hau")
    msgbox("What are you waiting for, go on!", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_up, face_left))
    waitmovement(LOCALID_PLAYER)
    call(TrainersSchool_BlockingTauros)
}

