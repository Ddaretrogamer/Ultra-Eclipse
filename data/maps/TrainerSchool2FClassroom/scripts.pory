        }
        elif (var(VAR_RESULT) == 2){
            msgbox("If a Pokémon falls asleep, it will be
            unable to attack.

            A Pokémon may wake up on its own,
            but if a battle ends while it is
            sleeping, it will stay asleep.

            Wake it up using an Awakening.")
            call(TrainersSchool2FClassroom_Blackboard2)
        }
        elif (var(VAR_RESULT) == 3){
            msgbox("A burn reduces Attack power, and it
            steadily reduces the victim's HP.

            A burn lingers after battle.
            Cure a burn using a Burn Heal.")
            call(TrainersSchool2FClassroom_Blackboard2)
        }
        elif (var(VAR_RESULT) == 4){
            msgbox("If a Pokémon is frozen, it becomes
            completely helpless.

            It will remain frozen after battle.
            Thaw it out using an Ice Heal.")
            call(TrainersSchool2FClassroom_Blackboard2)
        }
        elif (var(VAR_RESULT) == 5){
            release
            end
        }
    release
    end
}