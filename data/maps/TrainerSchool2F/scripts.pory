mapscripts TrainerSchool2F_MapScripts{}

script TeachersLoungeDoor{
    playse(SE_DOOR)
    warp(MAP_TRAINER_SCHOOL2FTEACHERS_LOUNGE, 0)
    end
}

script ClassroomDoor2F{
    playse(SE_DOOR)
    warp(MAP_TRAINER_SCHOOL2FCLASSROOM, 0)
    end
}

script TrainerSchool2F_BattleVsTeacher{
    lock
    faceplayer
    msgbox("{PLAYER}\.
    
    I can't believe that you{PAUSE 10}.{PAUSE 10}.{PAUSE 10}.
    beat all of my students! Fantastic!
    
    After seeing such a performance, I
    think I'd like to battle you myself!
    
    What do you say?
    {PAUSE 15}Are you ready to take me on?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES){
        if(var(VAR_STARTER_MON) == 0){
        msgbox("Good.

        I heard about you from Professor
        Kukui.
        
        I'll be challenging you with a
        Pokémon that has a type advantage
        against that Rowlet you chose!")
        trainerbattle_no_intro(TRAINER_SCHOOLTEACHER_EMILY_LITTEN, "Sensational!")
        }
        if(var(VAR_STARTER_MON) == 1){
        msgbox("Good.

        I heard about you from Professor
        Kukui.
        
        I'll be challenging you with a
        Pokémon that has a type advantage
        against that Litten you chose!")
        trainerbattle_no_intro(TRAINER_SCHOOLTEACHER_EMILY_POPPLIO, "Sensational!")
        }
        if(var(VAR_STARTER_MON) == 2){
        msgbox("Good.

        I heard about you from Professor
        Kukui.
        
        I'll be challenging you with a
        Pokémon that has a type advantage
        against that Popplio you chose!")
        trainerbattle_no_intro(TRAINER_SCHOOLTEACHER_EMILY_ROWLET, "Sensational!")
        }
        msgbox("Nice! Maybe you'd like to take over
        as teacher here for me!
        
        All joking aside, though, I do want you
        to take these from me\.
        
        It's a little reward for beating me.")
        giveitem(ITEM_GREAT_BALL, 5)
        startcutscene(CUTSCENE_TRAINER_SCHOOL_TEACHER_BATTLE)
        msgbox("They're Great Balls. Great Balls are
        better at catching Pokémon than
        normal Poké Balls.", MSGBOX_AUTOCLOSE)
        setobjectxy(trainerschool2f_kukui, 18, 9)
        playse(SE_DOOR)
        applymovement(trainerschool2f_kukui, moves(walk_down*2, delay_16*2, face_right))
        waitmovement(0)
        setobjectxy(trainerschool2f_ilima, 18, 9)
        playse(SE_DOOR)
        applymovement(trainerschool2f_ilima, moves(walk_down*1, face_right))
        waitmovement(0)
        speakername("Kukui")
        msgbox("Know your Pokémon their moves.
        Those are the basics of being a Trainer!")
        applymovement(LOCALID_PLAYER, moves(face_left))
        applymovement(trainerschool2f_teacher, moves(face_left))
        waitmovement(0)
        applymovement(trainerschool2f_kukui, moves(walk_in_place_right*2))
        waitmovement(0)
        msgbox("How about it?")
        applymovement(trainerschool2f_ilima, moves(walk_in_place_right*2))
        waitmovement(0)
        speakername("Ilima")
        msgbox("Greetings!
        {COLOR RED}Captain {COLOR DARK_GRAY}Ilima here.

        I couldn't help but observe your
        battles.

        You looked so very delightful in
        battle that I had no choice but to
        summon you here.")
        applymovement(trainerschool2f_kukui, moves(walk_in_place_right*2))
        waitmovement(0)
        checkplayergender
        if(var(VAR_RESULT) == MALE){
            speakername("Kukui")
            msgbox("This is {PLAYER}, who moved here to
            Alola from the Kanto region.
            
            He's got a real sense for how to use
            moves, and I think he's gonna go far
            as a trainer, yeah!")
        }
        else{
            speakername("Kukui")
            msgbox("This is {PLAYER}, who moved here to
            Alola from the Kanto region.
            
            She's got a real sense for how to use
            moves, and I think she's gonna go far
            as a trainer, yeah!")
        }
        applymovement(trainerschool2f_ilima, moves(walk_in_place_right*2))
        waitmovement(0)
        speakername("Ilima")
        msgbox("I see!
        Then welcome, newcomer.

        I look forward to seeing the brilliance
        of your moves in my {COLOR RED}trial{COLOR DARK_GRAY}.
        
        Indeed! We captains are the ones who
        conduct the trails you will face on
        your way to challenging the island
        kahuna.
        
        My trial is held in Verdant Cavern.
        The trial of Captain Ilima.
        
        You can find Pokémon living everywhere,
        even in the patches of tall grass in
        Hau'oli City.
        
        Perhaps you'll want to fill out your
        team a bit before attempting my
        trial?

        I sincerely look forward to your
        challenge.", MSGBOX_AUTOCLOSE)
        applymovement(trainerschool2f_ilima, moves(walk_up))
        waitmovement(0)
        setobjectxy(trainerschool2f_ilima, 16, 7)
        playse(SE_EXIT)
        waitse
        delay(30)
        applymovement(trainerschool2f_teacher, moves(jump_in_place_left*2))
        playse(SE_LEDGE)
        waitse
        playse(SE_LEDGE)
        waitse
        setflag(FLAG_SUPPRESS_SPEAKER_NAME)
        msgbox("Oh yeah!
        
        I reported to the folks upstairs about
        that Tauros blocking the road.")
        clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
        applymovement(trainerschool2f_kukui, moves(walk_in_place_right*2))
        waitmovement(0)
        speakername("Kukui")
        msgbox("That guy's Tauros is pretty much a
        celebrity here on Melemele, you know?")
        setflag(FLAG_SUPPRESS_SPEAKER_NAME)
        msgbox("Well, I guess it's time that we dismiss
        you from school, {PLAYER}")
        playse(SE_DING_DONG)
        applymovement(trainerschool2f_kukui, moves(emote_exclamation_mark, face_up))
        applymovement(trainerschool2f_teacher, moves(emote_exclamation_mark, face_up))
        applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark, face_up))
        waitmovement(0)
        waitse
        delay(15)
        checkplayergender
        endcutscene
        if(var(VAR_RESULT) == 0){
            msgbox("Attention, all students\.

            {PLAYER} has completed his lesson at
            the Trainers' School!")
        }
        else{
            msgbox("Attention, all students\.

            {PLAYER} has completed her lesson at
            the Trainers' School!")
        }
        clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
        setflag(FLAG_HIDE_TRAINERSCHOOL_LILLIE_KUKUI)
        setvar(VAR_IKITOWN_STATE, 23)
        warpsilent(MAP_ROUTE1N, 19, 14)
        waitstate
    }
    else{
        release
        end
    }
}

script TrainersSchool_Teacher_Battle_Skip{
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    setflag(FLAG_HIDE_TRAINERSCHOOL_LILLIE_KUKUI)
    setvar(VAR_IKITOWN_STATE, 23)
    special(StopAllObjectMovements)
    special(CloseScriptMenus)
    warpsilent(MAP_ROUTE1N, 19, 14)
    waitstate
    release
    end
}